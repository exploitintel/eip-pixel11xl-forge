# Config delta applied on top of the stock Pixel 11 Pro XL (kodiak) kernel
# config to run native Docker. Everything else follows from the stock
# /proc/config.gz of the same build. kernel/build.sh merges this fragment
# with scripts/kconfig/merge_config.sh and refuses unless the result has the
# exact SHA-256 recorded for the build.
#
# Namespaces and IPC that dockerd needs and the stock kernel leaves off.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
# The iptables match and target Docker's bridge and NAT rules use.
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
# The stock build is -Werror; the Debian toolchain warns where Google's does not.
# CONFIG_WERROR is not set
# Keep every exported symbol so the vendor modules resolve against this build.
# CONFIG_TRIM_UNUSED_KSYMS is not set
# Do not require Google's module signature for the protected module list.
CONFIG_MODULE_SIG_PROTECT_LIST=""
# The release string must equal the stock one; Google's build system appends
# the commit and ab number through scmversion, so set it verbatim here.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-android16-6-g5c5f2fea42dd-ab15835541-4k"
# This option is listed because the qualified config has it disabled and the
# merge must reproduce that config exactly.
# CONFIG_RUST_INLINE_HELPERS is not set
# Do NOT enable BRIDGE_NETFILTER, IP6_NF_NAT, CGROUP_PIDS or CGROUP_DEVICE:
# they change struct layouts the vendor modules depend on (BRIDGE_NETFILTER
# caused a panic in ppp_generic).
