.DS_Store
*.log
*.tmp
*.swp

# Stock firmware pulled for a local flash. check-public-tree.sh already refuses
it as a forbidden top-level path, but that guard only runs in CI, which is after
a push has already put 80MB of vendor images in public history.
stock/

# Build and candidate outputs never enter source history.
out/
dist/
.cache/
.work/
__pycache__/
*.pyc
kernel/source/
kernel/*.tar.gz
kernel/Image
kernel/Image.lz4
kernel/*.img

# Device images, firmware, Android state, and credentials are always private.
*.img
*.jks
*.keystore
*.pem
*.key
*.p12
*.env
.env*
!eip/container.build.env

# Android and complete installer build outputs.
.gradle/
android-app/build/
*.apk
*.tar
*.tgz
*.zip

# D4 is deliberately public, reproducibility-only test material. No other
# private-key path is permitted in this repository.
!kernel/keys/reproducibility/signing_key.pem
